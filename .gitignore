# Module :app
# Installed data
/app/src/main/assets/usr/
# Generated asset descriptor
/app/src/main/assets/descriptor.json

# Plugins
# Installed data
/plugin/*/src/main/assets/usr/
# Generated asset descriptor
/plugin/*/src/main/assets/descriptor.json

# Intellij
.idea/*
!.idea/codeStyles/
!.idea/copyright/
!.idea/dictionaries/

# below are generated by Android Studio

.DS_Store

# Android.gitignore
# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
#*.iml

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Android Profiling
*.hprof

### Kotlin ###
.kotlin/

# Local secrets. Deploy credentials must never reach the repository.
.env
.env.*
!.env.example

# Local verification evidence and generated release output
/.tmp-*
/.codex-remote-attachments/
/artifacts/
/.wrangler/
*.idsig
*.obj
**/obj/

# Local experiment evidence and generated automation files
/.artifacts/
**/__pycache__/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Scratch & temporary testing artifacts
/tmp-*
/tmp_*
/outputs/

# AI 코딩 도구의 개발자별 로컬 설정(graft 설치기 등이 만든다). 저장소 지침은 AGENTS.md·CLAUDE.md,
# 워커 정의는 .claude/agents/ 만 추적한다.
/.claude/*
!/.claude/agents/
/.codex/
/.cursor/
/.gemini/
/.grok/
/.kiro/
/.windsurf/
/.adal/
/.crush/
/.crush.json
/.playwright-mcp/
/.mcp.json
/.ignore
/opencode.json
/GEMINI.md
/.github/copilot-instructions.md
