<Window x:Class="SaegeulAiCompanionTray.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saegeul AI Companion Dashboard"
        Height="540" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#0F111A"
        Foreground="#ECEFF4"
        FontFamily="Segoe UI, Malgun Gothic">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E2233"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2E344E"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A3048"/>
                    <Setter Property="BorderBrush" Value="#6366F1"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#181B2B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="16" Background="#161926" CornerRadius="12" BorderBrush="#262C40" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="새글 AI Companion" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="2026.09 .NET 10 High-Performance Gateway" FontSize="11" Foreground="#8892B0" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" x:Name="StatusBadge" Background="#064E3B" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadgeText" Text="● 정상 작동 중" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                </Border>
            </Grid>
        </Border>

        <!-- Connectivity Summary Card -->
        <Border Grid.Row="1" Margin="0,0,0,16" Padding="16" Background="#161926" CornerRadius="12" BorderBrush="#262C40" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="네트워크 &amp; 포트 정보" FontSize="13" FontWeight="SemiBold" Foreground="#A6ACCD" Margin="0,0,0,10"/>
                
                <Grid Margin="0,2">
                    <TextBlock Text="로컬 게이트웨이" FontSize="12" Foreground="#8892B0"/>
                    <TextBlock x:Name="LocalEndpointText" Text="http://127.0.0.1:9211" FontSize="12" FontWeight="Bold" Foreground="#818CF8" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,4">
                    <TextBlock Text="Tailscale HTTPS" FontSize="12" Foreground="#8892B0"/>
                    <TextBlock x:Name="TailscaleEndpointText" Text="https://[Device]:9210" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,4">
                    <TextBlock Text="활성 AI 백엔드" FontSize="12" Foreground="#8892B0"/>
                    <TextBlock x:Name="BackendSummaryText" Text="Codex · Claude · AGY" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Actions and Quick Config -->
        <Border Grid.Row="2" Padding="16" Background="#161926" CornerRadius="12" BorderBrush="#262C40" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="모바일 기기 연동 &amp; 빠른 도구" FontSize="13" FontWeight="SemiBold" Foreground="#A6ACCD" Margin="0,0,0,12"/>

                <Button x:Name="AdbReverseButton" Content="📱 USB 기기 포트포워딩 (adb reverse tcp:9211)" Margin="0,0,0,8" Click="OnAdbReverseClick"/>
                <Button x:Name="OpenBrowserButton" Content="🌐 브라우저에서 상태 대시보드 열기" Margin="0,0,0,8" Click="OnOpenBrowserClick"/>
                <Button x:Name="RestartGatewayButton" Content="🔄 게이트웨이 재시작" Margin="0,0,0,8" Click="OnRestartGatewayClick"/>

                <!-- Android .NET / MAUI Compatibility Hint -->
                <Border Margin="0,8,0,0" Padding="12" Background="#1F2438" CornerRadius="8" BorderBrush="#3B4261" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="💡 .NET / Android 앱 한글 호환 모드" FontSize="11" FontWeight="Bold" Foreground="#FBBF24"/>
                        <TextBlock Text="안드로이드 새글 키보드 도구 모음의 [한글 버퍼 호환 모드]를 켜시면 .NET MAUI / Xamarin / 원격 데스크톱에서도 글자 깨짐 없이 완벽하게 입력됩니다." 
                                   FontSize="10.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="14"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="3" Text="새글(Saegeul) AI Companion v0.1.0 · 2026 YunChan" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" Margin="0,12,0,0"/>
    </Grid>
</Window>
