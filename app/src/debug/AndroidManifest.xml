<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          This host exists only in the debug source set.  It has no intent filter and is exported
          solely so a connected emulator can launch the exact component with adb.
        -->
        <activity
            android:name="org.fcitx.fcitx5.android.debug.AiEditorTestActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="AI editor E2E (debug)"
            android:theme="@style/Theme.FcitxAppTheme"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />
        <!--
          Experiment UI for the on-device Gemma pipeline (model download/import, manual generation).
          The pipeline itself now ships in every build variant (see AGENTS.md's Gemma production
          milestone); this activity stays debug-only until the product model-management screen
          (a later milestone) replaces it.
        -->
        <activity
            android:name="org.fcitx.fcitx5.android.debug.gemma.GemmaExperimentActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Gemma 재료 실험"
            android:theme="@style/Theme.FcitxAppTheme" />
    </application>

</manifest>
