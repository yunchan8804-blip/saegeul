<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- remove unused permission from AppCompat -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      On-device Gemma material accumulation and personal-graph enrichment run their manual/periodic
      passes as a WorkManager foreground service (Android 14+ requires a declared type for the
      WorkManager-provided SystemForegroundService, or the OS kills the worker as a short-lived
      background job mid-generation).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <queries>
        <intent>
            <action android:name="${applicationId}.plugin.MANIFEST" />
        </intent>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <permission
        android:name="${applicationId}.permission.IPC"
        android:protectionLevel="signature" />

    <permission
        android:name="${applicationId}.permission.PLUGIN"
        android:protectionLevel="signature" />

    <uses-permission android:name="${applicationId}.permission.PLUGIN" />

    <application
        android:name=".FcitxApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/app_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/app_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FcitxAppTheme"
        tools:targetApi="33">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!--
          On-device Gemma (LiteRT-LM) uses these when present but must not fail to load without
          them: OpenCL backs the optional GPU accelerator, and libvndksupport is a vendor NDK shim
          some OEM builds route OpenCL through.
        -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />

        <activity
            android:name=".ui.setup.SetupActivity"
            android:exported="false"
            android:launchMode="singleTask" />
        <activity
            android:name=".ui.main.LogActivity"
            android:directBootAware="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:parentActivityName=".ui.main.MainActivity" />
        <activity
            android:name=".ui.main.settings.theme.CustomThemeActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="@string/edit_theme" />
        <activity
            android:name=".ui.main.CropImageActivity"
            android:exported="false" />
        <receiver
            android:name=".ui.main.ai.VaultWidgetProvider"
            android:exported="false"
            android:label="내 언어 금고">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/vault_widget_info" />
        </receiver>
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.main.ClipboardEditActivity"
            android:autoRemoveFromRecents="true"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:label="@string/edit_clipboard"
            android:launchMode="singleInstance"
            android:taskAffinity=".ui.main.ClipboardEditActivity"
            android:theme="@style/Theme.DialogTheme"
            android:windowSoftInputMode="stateAlwaysVisible|adjustPan" />

        <!--
          InputMethodService cannot call requestPermissions. The current IME is an allowed
          background-activity-start case, so a user tap opens this internal translucent boundary.
          Do not use Theme.NoDisplay or noHistory: both can finish before the permission result.
        -->
        <activity
            android:name=".input.voice.VoicePermissionActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.VoicePermission" />

        <!-- BiometricPrompt must be owned by an Activity, not the detachable IME window. -->
        <activity
            android:name=".input.dynamicphrase.SensitivePhraseAuthActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.VoicePermission" />

        <!-- One-shot system image picker for local OCR. The selected URI is never persisted. -->
        <activity
            android:name=".input.ocr.OcrDocumentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.VoicePermission" />

        <activity
            android:name=".ui.main.ai.TypingDnaDashboardActivity"
            android:exported="false"
            android:label="AI 언어 지문 대시보드"
            android:parentActivityName=".ui.main.MainActivity"
            android:theme="@style/Theme.TypingDnaDashboard" />

        <activity
            android:name=".ui.main.ai.install.GemmaModelActivity"
            android:exported="false"
            android:label="@string/gemma_model_activity_title"
            android:parentActivityName=".ui.main.MainActivity"
            android:theme="@style/Theme.TypingDnaDashboard" />

        <activity
            android:name=".ui.main.ai.backup.VaultBackupActivity"
            android:exported="false"
            android:label="@string/vault_backup_title"
            android:parentActivityName=".ui.main.MainActivity" />

        <activity
            android:name=".ui.main.ai.StyleReportActivity"
            android:exported="false"
            android:label="@string/style_report_title"
            android:parentActivityName=".ui.main.ai.TypingDnaDashboardActivity"
            android:theme="@style/Theme.TypingDnaDashboard" />

        <service
            android:name=".input.FcitxInputMethodService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/input_method" />
        </service>

        <service
            android:name=".FcitxRemoteService"
            android:exported="true"
            android:permission="${applicationId}.permission.IPC"
            tools:ignore="SystemPermissionTypo">
            <intent-filter>
                <action android:name="${applicationId}.IPC" />
            </intent-filter>
        </service>
        <provider
            android:name=".provider.FcitxDataProvider"
            android:authorities="${applicationId}.provider"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.gifcontent"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/gif_file_paths" />
        </provider>

        <!-- remove unneeded components from com.canhub.cropper -->
        <!--suppress DeprecatedClassUsageInspection -->
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            tools:node="remove" />

        <provider
            android:name="com.canhub.cropper.CropFileProvider"
            android:authorities="${applicationId}.cropper.fileprovider"
            tools:node="remove" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:directBootAware="true"
            android:exported="false"
            tools:node="merge">
            <!-- do not inject splitties AppCompat -->
            <meta-data
                android:name="splitties.views.dsl.appcompat.experimental.AppCompatViewInstantiatorInjecter"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
