    <string name="gemma_automatic_enable">AI sentence suggestions</string>
    <string name="gemma_automatic_enable_description">Suggests on-device using the current app and the text you\'re typing. Neither the text nor the suggestions are saved to a file, and they\'re cleared when you close the keyboard. This setting persists across keyboard restarts, and suggestions pause when battery, heat, or memory conditions aren\'t met.</string>
    <string name="gemma_automatic_cpu_compatibility">CPU compatibility mode</string>
    <string name="gemma_automatic_cpu_compatibility_description">Uses the CPU instead of the GPU. Suggestions may be slower depending on your device.</string>
