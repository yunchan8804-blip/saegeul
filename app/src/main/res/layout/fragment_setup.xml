<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".ui.setup.SetupFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/saegeul_screen_inset"
        android:paddingTop="32dp"
        android:paddingEnd="@dimen/saegeul_screen_inset"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/app_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/app_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/setup_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/saegeul_setup_title"
                    android:textColor="@color/saegeul_ink"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/setup_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/saegeul_setup_summary"
                    android:textColor="@color/saegeul_secondary"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/ai_new_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/setup_ai_new_title"
            android:textColor="@color/saegeul_ink"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="@color/saegeul_surface"
            app:cardCornerRadius="@dimen/saegeul_card_radius"
            app:strokeColor="@color/saegeul_outline"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/hint_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:padding="@dimen/saegeul_screen_inset"
                android:textColor="@color/saegeul_ink"
                android:textSize="16sp"
                tools:text="Hint text here ..." />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/ai_consent_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/gemma_install_consent_message"
            android:textColor="@color/saegeul_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/ai_consent_terms_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:minHeight="@dimen/saegeul_touch_target"
            android:gravity="center_vertical"
            android:text="@string/gemma_install_consent_terms_button"
            android:textColor="@color/saegeul_action"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <include
            android:id="@+id/ai_install_status"
            layout="@layout/view_gemma_install_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/ai_secondary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setup_ai_new_secondary"
            android:textColor="@color/saegeul_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/saegeul_action"
            android:minHeight="@dimen/saegeul_touch_target"
            android:textColor="@color/saegeul_on_action"
            android:textSize="16sp"
            app:cornerRadius="@dimen/saegeul_button_radius"
            tools:text="Action" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/ai_suggestion_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="@dimen/saegeul_touch_target"
            android:text="@string/gemma_automatic_enable"
            android:textColor="@color/saegeul_ink"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/done_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_baseline_check_circle_24"
                android:tint="@color/saegeul_action" />

            <TextView
                android:id="@+id/done_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/done"
                android:textColor="@color/saegeul_action"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
