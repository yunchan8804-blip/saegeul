<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_typing_dna"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="AI 언어 지문 학습 현황 카드"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_baseline_auto_awesome_24"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="AI 언어 지문 학습 현황"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_main_card_level_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dna_level_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Lv.1"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_main_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="새싹 학습자 · 기기 내 학습 진행 중"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_main_card_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="분석 문장 0개 · 학습 단어쌍 0개"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <!-- Mini Progress Bar -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_main_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:contentDescription="학습 레벨 진행률"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp" />

        <org.fcitx.fcitx5.android.ui.main.ai.TypingDnaChartView
            android:id="@+id/mini_chart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="AI 언어 지문 요약 그래프"
            android:importantForAccessibility="no" />

        <!-- 4 Metric Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_metric_sentences"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dna_metric_chip"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="문장 0"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_metric_bigrams"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dna_metric_chip"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="단어쌍 0"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_metric_endings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dna_metric_chip"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="어미 0"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_metric_phrases"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dna_metric_chip"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="상용구 0"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_dna_card_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="상세 그래프 보기"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_baseline_keyboard_arrow_right_24"
                app:tint="?attr/colorPrimary" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
