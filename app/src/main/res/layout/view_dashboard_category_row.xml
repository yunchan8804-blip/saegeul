<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tv_category_row_label"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="11sp"
        tools:text="검색·브라우저" />

    <LinearLayout
        android:id="@+id/container_category_row_bar"
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:layout_marginHorizontal="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_dna_metric_chip"
        android:orientation="horizontal"
        android:weightSum="1">

        <View
            android:id="@+id/view_category_row_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:background="@drawable/bg_dna_level_badge" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_category_row_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:text="0%"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="12sp"
        tools:text="42% · 3/10 대기" />

    <TextView
        android:id="@+id/tv_category_row_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:alpha="0.5"
        android:text="@string/vault_category_row_empty"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
